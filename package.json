{
  "name": "code-journey",
  "version": "0.1.0",
  "private": true,
  "description": "Free, next-generation coding education platform: structured curriculum, interactive auto-graded challenges, progress tracking, community, and a pedagogy-first AI mentor.",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "node --import tsx --import ./scripts/worker-imports.mjs src/workers/runner.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@mdx-js/mdx": "3.1.1",
    "@next/mdx": "16.3.4",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "~9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
