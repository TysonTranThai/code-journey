  "title": "Median With Tests",
  "prompt": "Implement `median(v)` (middle of sorted copy; average of two middles for even size; 0.0 for empty — no exception). Tests cover odd, even, empty, single, and unsorted input.",
  "difficulty": "beginner",
  "language": "cpp",
  "boilerplate": "#include <algorithm>\n#include <stdexcept>\n#include <vector>\n\ndouble median(const std::vector<int>& v) {\n    // TODO\n}",
  "tests": [
    {
      "name": "odd",
      "code": "CHECK_NEAR(median({3, 1, 2}), 2.0, 0.001);",
      "hint": "Sort first: middle of {1,2,3}."
    },
    {
      "name": "even",
      "code": "CHECK_NEAR(median({4, 1, 3, 2}), 2.5, 0.001);",
      "hint": "Average of the two middles."
    },
    {
      "name": "empty",
      "code": "CHECK_NEAR(median({}), 0.0, 0.001);",
      "hint": "Empty is defined here as 0.0."
    },
    {
      "name": "unsorted",
      "code": "CHECK_NEAR(median({9, 1}), 5.0, 0.001);",
