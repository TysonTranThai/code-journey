{
  "id": "cppi-m11-count-islands",
  "title": "Connected components (flood fill)",
  "prompt": "Implement `int count_islands(const std::vector<std::string>& grid)` where '1' is land and '0' is water; an island is a maximal group of '1's connected horizontally or vertically. Sink each island as you find it (mutate the grid copy or use a visited matrix) and count the discoveries. This is DFS/BFS on a grid.",
  "difficulty": "intermediate",
  "language": "cpp",
  "boilerplate": "#include <string>\n#include <vector>\n#include <iostream>\n\n// int count_islands(const std::vector<std::string>& grid)\n",
  "tests": [
    {
      "name": "one-island",
      "code": "std::vector<std::string> g{\"110\",\n                          \"110\",\n                          \"000\"};\nCHECK_EQ(count_islands(g), 1);",
      "hint": "All the 1s touch: one island."
    },
    {
      "name": "three-islands",
      "code": "std::vector<std::string> g{\"101\",\n                          \"010\",\n                          \"101\"};\nCHECK_EQ(count_islands(g), 5);",
      "hint": "Diagonal does NOT connect: five separate islands."
    },
    {
      "name": "all-water",
      "code": "std::vector<std::string> g{\"000\",\n                          \"000\"};\nCHECK_EQ(count_islands(g), 0);",
      "hint": "No land, no islands."
    },
    {
      "name": "single-cell",
      "code": "std::vector<std::string> g{\"1\"};\nCHECK_EQ(count_islands(g), 1);",
      "hint": "One cell is one island."
    }
  ],
  "level": "real-world"
}
