{
  "id": "py-fmt-slug",
  "title": "URL Slug Maker",
  "prompt": "title = \"  Learn Python FAST! \" is given. Convert it to a slug: trim, lowercase, spaces to dashes: learn-python-fast-",
  "difficulty": "beginner",
  "language": "python",
  "boilerplate": "title = \"  Learn Python FAST! \"\n",
  "tests": [
    {
      "name": "prints slug",
      "code": "assert printed == [\"learn-python-fast!\"], f\"got {printed}\"",
      "hint": "title.strip().lower().replace(\" \", \"-\") — punctuation stays for now."
    }
  ],
  "level": "mini-build"
}
