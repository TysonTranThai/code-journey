{
  "id": "pi1-comp-dict",
  "title": "Word Length Lookup",
  "prompt": "Implement length_lookup(words) returning a dict mapping each word to its length, using a dict comprehension.",
  "difficulty": "intermediate",
  "language": "python",
  "boilerplate": "def length_lookup(words):\n    pass\n",
  "tests": [
    {
      "name": "maps words to lengths",
      "code": "assert length_lookup([\"tea\", \"cola\"]) == {\"tea\": 3, \"cola\": 4}",
      "hint": "{w: len(w) for w in words}."
    },
    {
      "name": "handles duplicates by keeping one entry",
      "code": "assert length_lookup([\"hi\", \"hi\"]) == {\"hi\": 2}",
      "hint": "Dict keys are unique; duplicates collapse to one entry."
    },
    {
      "name": "empty list gives empty dict",
      "code": "assert length_lookup([]) == {}",
      "hint": "Edge case: no words → {}."
    }
  ],
  "level": "guided"
}
