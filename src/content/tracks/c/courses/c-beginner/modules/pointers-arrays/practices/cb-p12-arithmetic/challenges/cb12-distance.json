{
  "id": "cb12-distance",
  "title": "Distance Between",
  "prompt": "Implement `long index_of(const int *begin, const int *end, int target)` returning the ELEMENT DISTANCE from begin to the first match, or -1 if absent. Compute with pointer subtraction on a found position.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "middle",
      "code": "int a[] = {10, 20, 30};\nCHECK_EQ(index_of(a, a + 3, 30), 2);",
      "hint": "p - begin is the index."
    },
    {
      "name": "first",
      "code": "int a[] = {10, 20};\nCHECK_EQ(index_of(a, a + 2, 10), 0);",
      "hint": "Distance 0 is valid."
    },
    {
      "name": "absent",
      "code": "int a[] = {10, 20};\nCHECK_EQ(index_of(a, a + 2, 99), -1);",
      "hint": "Not found keeps -1."
    }
  ],
  "level": "independent"
}
