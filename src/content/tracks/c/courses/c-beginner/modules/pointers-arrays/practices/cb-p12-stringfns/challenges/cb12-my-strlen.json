{
  "id": "cb12-my-strlen",
  "title": "my_strlen",
  "prompt": "Implement `size_t my_strlen(const char *s)` counting characters up to (not including) the NUL terminator, WITHOUT calling strlen.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "basic",
      "code": "CHECK_EQ(my_strlen(\"hello\"), 5);",
      "hint": "Walk until *s == '\\\\0'."
    },
    {
      "name": "empty",
      "code": "CHECK_EQ(my_strlen(\"\"), 0);",
      "hint": "Empty string: terminator first."
    },
    {
      "name": "single",
      "code": "CHECK_EQ(my_strlen(\"x\"), 1);",
      "hint": "One char, then NUL."
    },
    {
      "name": "spaces count",
      "code": "CHECK_EQ(my_strlen(\"a b\"), 3);",
      "hint": "Every byte before NUL counts."
    }
  ],
  "level": "guided"
}
