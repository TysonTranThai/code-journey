{
  "id": "cb12-ptr-sum",
  "title": "Sum by Walker",
  "prompt": "Implement `int sum_by_ptr(const int *begin, const int *end)` adding all elements from begin (inclusive) to end (exclusive) using ONLY pointer arithmetic — no [] indexing.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "whole array",
      "code": "int a[] = {1, 2, 3, 4};\nCHECK_EQ(sum_by_ptr(a, a + 4), 10);",
      "hint": "a + 4 is one past the last."
    },
    {
      "name": "empty range",
      "code": "int a[] = {9};\nCHECK_EQ(sum_by_ptr(a, a), 0);",
      "hint": "begin == end: empty."
    },
    {
      "name": "middle slice",
      "code": "int a[] = {1, 2, 3, 4};\nCHECK_EQ(sum_by_ptr(a + 1, a + 3), 5);",
      "hint": "Ranges can start anywhere."
    },
    {
      "name": "negatives",
      "code": "int a[] = {-1, -2, -3};\nCHECK_EQ(sum_by_ptr(a, a + 3), -6);",
      "hint": "Signs add."
    }
  ],
  "level": "guided"
}
