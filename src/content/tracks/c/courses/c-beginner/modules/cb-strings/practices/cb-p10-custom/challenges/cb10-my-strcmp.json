{
  "id": "cb10-my-strcmp",
  "title": "my_strcmp",
  "prompt": "Implement `int my_strcmp(const char* a, const char* b)` returning negative/zero/positive like strcmp, without calling it.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "equal",
      "code": "CHECK_EQ(my_strcmp(\"abc\", \"abc\"), 0);",
      "hint": "Walk while both match."
    },
    {
      "name": "less",
      "code": "CHECK(my_strcmp(\"abc\", \"abd\") < 0);",
      "hint": "First differing character decides."
    },
    {
      "name": "prefix",
      "code": "CHECK(my_strcmp(\"ab\", \"abc\") < 0);",
      "hint": "The shorter string ends first: its terminator is 'smaller'."
    }
  ],
  "level": "guided"
}
