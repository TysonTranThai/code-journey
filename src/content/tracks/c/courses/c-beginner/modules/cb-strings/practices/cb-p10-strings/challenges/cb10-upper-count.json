{
  "id": "cb10-upper-count",
  "title": "Uppercase Counter",
  "prompt": "Implement `int count_upper(const char* s)` counting 'A'..'Z' characters.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "mixed",
      "code": "CHECK_EQ(count_upper(\"Hello World\"), 2);",
      "hint": "Walk until the terminator."
    },
    {
      "name": "none",
      "code": "CHECK_EQ(count_upper(\"quiet\"), 0);",
      "hint": "No matches: 0."
    },
    {
      "name": "all",
      "code": "CHECK_EQ(count_upper(\"ABC\"), 3);",
      "hint": "Every character matches."
    }
  ],
  "level": "guided"
}
