{
  "id": "cb10-censor-vowels",
  "title": "Vowel Censor",
  "prompt": "Implement `void censor(char* s)` replacing every vowel (a/e/i/o/u, both cases) IN PLACE with '*'.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "mixed",
      "code": "char s[] = \"banana\";\ncensor(s);\nCHECK_STR_EQ(s, \"b*n*n*\");",
      "hint": "Modify the writable copy."
    },
    {
      "name": "no vowels",
      "code": "char s[] = \"rhythm\";\ncensor(s);\nCHECK_STR_EQ(s, \"rhythm\");",
      "hint": "Nothing changes."
    },
    {
      "name": "case",
      "code": "char s[] = \"ApE\";\ncensor(s);\nCHECK_STR_EQ(s, \"*p*\");",
      "hint": "Handle uppercase too."
    }
  ],
  "level": "independent"
}
