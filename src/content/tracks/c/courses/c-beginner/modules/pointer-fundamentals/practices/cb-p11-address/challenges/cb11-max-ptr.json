{
  "id": "cb11-max-ptr",
  "title": "Pointer to the Max",
  "prompt": "Implement `const int* max_ptr(const int* a, int n)` returning a pointer to the LARGEST element of the first n elements (n >= 1).",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "middle winner",
      "code": "int a[] = {1, 9, 2};\nCHECK_EQ(*max_ptr(a, 3), 9);",
      "hint": "Track the best element's pointer."
    },
    {
      "name": "same address",
      "code": "int a[] = {1, 9, 2};\nCHECK_EQ(max_ptr(a, 3), &a[1]);",
      "hint": "Return the ADDRESS, not a copy."
    },
    {
      "name": "first element",
      "code": "int a[] = {7, 2};\nCHECK_EQ(max_ptr(a, 2), &a[0]);",
      "hint": "Max can be the first."
    },
    {
      "name": "last element",
      "code": "int a[] = {1, 2, 8};\nCHECK_EQ(max_ptr(a, 3), &a[2]);",
      "hint": "Or the last."
    }
  ],
  "level": "guided"
}
