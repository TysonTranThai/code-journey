{
  "id": "cb11-pick-valid",
  "title": "First Non-Null",
  "prompt": "Implement `int* first_valid(int *a, int *b, int *c)` returning the first pointer that is not NULL; if all are NULL return NULL.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "first wins",
      "code": "int x = 1;\nCHECK_EQ(first_valid(&x, NULL, NULL), &x);",
      "hint": "Check a first."
    },
    {
      "name": "second wins",
      "code": "int y = 2;\nCHECK_EQ(first_valid(NULL, &y, NULL), &y);",
      "hint": "Then b."
    },
    {
      "name": "third wins",
      "code": "int z = 3;\nCHECK_EQ(first_valid(NULL, NULL, &z), &z);",
      "hint": "Then c."
    },
    {
      "name": "all null",
      "code": "CHECK_EQ(first_valid(NULL, NULL, NULL), NULL);",
      "hint": "Every one NULL: return NULL."
    }
  ],
  "level": "independent"
}
