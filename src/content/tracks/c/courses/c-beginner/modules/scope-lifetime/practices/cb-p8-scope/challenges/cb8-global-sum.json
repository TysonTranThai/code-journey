{
  "id": "cb8-global-sum",
  "title": "Parameter, Not Global",
  "prompt": "Implement `int total_sum(const int* a, int n)` returning the sum — full marks only if you use NO file-scope variables (parameter in, return out).",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "basics",
      "code": "int a[] = {1, 2, 3};\nCHECK_EQ(total_sum(a, 3), 6);",
      "hint": "Accumulate a local and return it."
    },
    {
      "name": "empty",
      "code": "int a[] = {9};\nCHECK_EQ(total_sum(a, 0), 0);",
      "hint": "n=0 means no elements: 0."
    },
    {
      "name": "negatives",
      "code": "int a[] = {-4, 4};\nCHECK_EQ(total_sum(a, 2), 0);",
      "hint": "Signs cancel."
    }
  ],
  "level": "independent"
}
