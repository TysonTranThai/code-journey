{
  "id": "cb4-in-range",
  "title": "In Range?",
  "prompt": "Implement `int in_range(int x, int lo, int hi)` returning 1 when `lo <= x <= hi` and 0 otherwise — as one boolean expression.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "inside",
      "code": "CHECK_EQ(in_range(5, 1, 10), 1);",
      "hint": "x >= lo && x <= hi."
    },
    {
      "name": "below",
      "code": "CHECK_EQ(in_range(0, 1, 10), 0);",
      "hint": "Fails the left half."
    },
    {
      "name": "above",
      "code": "CHECK_EQ(in_range(11, 1, 10), 0);",
      "hint": "Fails the right half."
    },
    {
      "name": "boundaries count",
      "code": "CHECK_EQ(in_range(1, 1, 10), 1);\nCHECK_EQ(in_range(10, 1, 10), 1);",
      "hint": "Both ends are inclusive."
    }
  ],
  "level": "imitation"
}
