{
  "id": "cb5-bmi-band",
  "title": "BMI Band",
  "prompt": "Implement `const char* bmi_band(double bmi)`: below 18.5 -> \"under\", below 25 -> \"normal\", below 30 -> \"over\", else \"obese\". Return the exact strings.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "under",
      "code": "CHECK_STR_EQ(bmi_band(17.0), \"under\");",
      "hint": "First threshold."
    },
    {
      "name": "normal boundary",
      "code": "CHECK_STR_EQ(bmi_band(18.5), \"normal\");\nCHECK_STR_EQ(bmi_band(24.9), \"normal\");",
      "hint": "18.5 is INCLUDED in normal."
    },
    {
      "name": "over",
      "code": "CHECK_STR_EQ(bmi_band(25.0), \"over\");",
      "hint": "25 starts the over band."
    },
    {
      "name": "obese",
      "code": "CHECK_STR_EQ(bmi_band(31.0), \"obese\");",
      "hint": "The final else."
    }
  ],
  "level": "guided"
}
