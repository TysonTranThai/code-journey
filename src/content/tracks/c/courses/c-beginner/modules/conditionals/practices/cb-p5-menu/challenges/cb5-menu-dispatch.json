{
  "id": "cb5-menu-dispatch",
  "title": "Menu Dispatch",
  "prompt": "Implement `const char* menu_action(int choice)` using switch: 1 -> \"deposit\", 2 -> \"withdraw\", 3 -> \"balance\", any other value -> \"unknown\".",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "known choices",
      "code": "CHECK_STR_EQ(menu_action(1), \"deposit\");\nCHECK_STR_EQ(menu_action(2), \"withdraw\");\nCHECK_STR_EQ(menu_action(3), \"balance\");",
      "hint": "One case per choice, each with break."
    },
    {
      "name": "default catches rest",
      "code": "CHECK_STR_EQ(menu_action(9), \"unknown\");\nCHECK_STR_EQ(menu_action(-1), \"unknown\");",
      "hint": "The default label."
    }
  ],
  "level": "imitation"
}
