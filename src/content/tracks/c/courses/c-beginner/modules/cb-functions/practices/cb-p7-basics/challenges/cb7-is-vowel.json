{
  "id": "cb7-is-vowel",
  "title": "Vowel Test",
  "prompt": "Implement `int is_vowel(char c)` returning 1 for a/e/i/o/u (and their uppercase), else 0.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "lowercase",
      "code": "CHECK_EQ(is_vowel('a'), 1);\nCHECK_EQ(is_vowel('e'), 1);",
      "hint": "Check each vowel."
    },
    {
      "name": "uppercase",
      "code": "CHECK_EQ(is_vowel('U'), 1);",
      "hint": "Handle both cases."
    },
    {
      "name": "consonants",
      "code": "CHECK_EQ(is_vowel('x'), 0);\nCHECK_EQ(is_vowel('Z'), 0);",
      "hint": "Return 0."
    },
    {
      "name": "non-letters",
      "code": "CHECK_EQ(is_vowel('1'), 0);",
      "hint": "Digits aren't vowels."
    }
  ],
  "level": "guided"
}
