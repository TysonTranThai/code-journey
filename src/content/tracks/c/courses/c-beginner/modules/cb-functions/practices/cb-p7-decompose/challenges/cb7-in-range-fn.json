{
  "id": "cb7-in-range-fn",
  "title": "Range Helper",
  "prompt": "Implement `int in_range(int v, int lo, int hi)` returning 1 when lo <= v <= hi (inclusive both ends).",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "inside",
      "code": "CHECK_EQ(in_range(5, 1, 10), 1);",
      "hint": "Both comparisons hold."
    },
    {
      "name": "edges",
      "code": "CHECK_EQ(in_range(1, 1, 10), 1);\nCHECK_EQ(in_range(10, 1, 10), 1);",
      "hint": "Inclusive edges."
    },
    {
      "name": "outside",
      "code": "CHECK_EQ(in_range(0, 1, 10), 0);\nCHECK_EQ(in_range(11, 1, 10), 0);",
      "hint": "Both sides fail."
    }
  ],
  "level": "imitation"
}
