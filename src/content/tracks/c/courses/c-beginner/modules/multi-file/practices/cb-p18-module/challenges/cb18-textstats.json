{
  "id": "cb18-textstats",
  "title": "textstats: Word Count",
  "prompt": "Implement public `int count_words(const char *s)` where words are maximal runs of non-space characters (space = ' ', '\\t', '\\n'), with a static helper for the space test.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <string.h>\n",
  "tests": [
    {
      "name": "basic",
      "code": "CHECK_EQ(count_words(\"one two three\"), 3);",
      "hint": "Three runs."
    },
    {
      "name": "extra spaces",
      "code": "CHECK_EQ(count_words(\"  a   b  \"), 2);",
      "hint": "Leading/trailing/extra ignored."
    },
    {
      "name": "tabs and newlines",
      "code": "CHECK_EQ(count_words(\"a\\tb\\nc\"), 3);",
      "hint": "All whitespace separates."
    },
    {
      "name": "empty",
      "code": "CHECK_EQ(count_words(\"\"), 0);",
      "hint": "No characters, no words."
    }
  ],
  "level": "independent"
}
