{
  "id": "cb18-counter-module",
  "title": "Counter Module",
  "prompt": "Build a counter module: private file-scope state, public `void counter_reset(void)`, `void counter_add(int n)`, and `int counter_value(void)` returning the running total.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n",
  "tests": [
    {
      "name": "starts at zero",
      "code": "counter_reset();\nCHECK_EQ(counter_value(), 0);",
      "hint": "Reset defines the zero point."
    },
    {
      "name": "accumulates",
      "code": "counter_reset();\ncounter_add(5);\ncounter_add(7);\nCHECK_EQ(counter_value(), 12);",
      "hint": "Adds accumulate."
    },
    {
      "name": "negative add",
      "code": "counter_reset();\ncounter_add(3);\ncounter_add(-2);\nCHECK_EQ(counter_value(), 1);",
      "hint": "Add can subtract."
    }
  ],
  "level": "guided"
}
