{
  "id": "cb9-linear-search",
  "title": "Linear Search",
  "prompt": "Implement `int find(const int* a, int n, int target)` returning the FIRST index holding target, or -1 if absent.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "present",
      "code": "int a[] = {4, 8, 15};\nCHECK_EQ(find(a, 3, 15), 2);",
      "hint": "Return the index."
    },
    {
      "name": "first match wins",
      "code": "int a[] = {5, 5, 5};\nCHECK_EQ(find(a, 3, 5), 0);",
      "hint": "Stop at the first hit."
    },
    {
      "name": "absent",
      "code": "int a[] = {1, 2};\nCHECK_EQ(find(a, 2, 9), -1);",
      "hint": "-1 means not found."
    }
  ],
  "level": "guided"
}
