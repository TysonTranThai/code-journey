{
  "id": "cb9-array-max",
  "title": "Array Max",
  "prompt": "Implement `int array_max(const int* a, int n)` returning the largest element (n >= 1 guaranteed).",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "basics",
      "code": "int a[] = {3, 9, 4};\nCHECK_EQ(array_max(a, 3), 9);",
      "hint": "Start from a[0]."
    },
    {
      "name": "first is max",
      "code": "int a[] = {7, 2, 1};\nCHECK_EQ(array_max(a, 3), 7);",
      "hint": "Compare every element."
    },
    {
      "name": "all equal",
      "code": "int a[] = {4, 4, 4};\nCHECK_EQ(array_max(a, 3), 4);",
      "hint": "Max of equals is that value."
    },
    {
      "name": "negatives",
      "code": "int a[] = {-9, -2, -5};\nCHECK_EQ(array_max(a, 3), -2);",
      "hint": "Works below zero."
    },
    {
      "name": "max after dip",
      "code": "int a[] = {5, 3, 9};\nCHECK_EQ(array_max(a, 3), 9);",
      "hint": "Scan EVERY element — the max can come last."
    }
  ],
  "level": "guided"
}
