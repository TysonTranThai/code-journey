{
  "id": "cb9-array-reverse",
  "title": "In-Place Reverse",
  "prompt": "Implement `void reverse(int* a, int n)` reversing the first n elements IN PLACE (no second array).",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "even length",
      "code": "int a[] = {1, 2, 3, 4};\nreverse(a, 4);\nCHECK_EQ(a[0], 4);\nCHECK_EQ(a[3], 1);",
      "hint": "Swap ends, move inward."
    },
    {
      "name": "odd length",
      "code": "int a[] = {1, 2, 3};\nreverse(a, 3);\nCHECK_EQ(a[1], 2);",
      "hint": "The middle stays."
    },
    {
      "name": "single",
      "code": "int a[] = {9};\nreverse(a, 1);\nCHECK_EQ(a[0], 9);",
      "hint": "One element: nothing to do."
    }
  ],
  "level": "independent"
}
