{
  "id": "cb21-selection-sort",
  "title": "Selection Sort",
  "prompt": "Implement `void selection_sort(int *a, int n)` sorting ascending in place.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "basic",
      "code": "int a[] = {3, 1, 2};\nselection_sort(a, 3);\nCHECK_EQ(a[0], 1);\nCHECK_EQ(a[2], 3);",
      "hint": "Smallest first."
    },
    {
      "name": "sorted stays",
      "code": "int a[] = {1, 2, 3};\nselection_sort(a, 3);\nCHECK_EQ(a[1], 2);",
      "hint": "Already ordered: no harm."
    },
    {
      "name": "duplicates",
      "code": "int a[] = {2, 1, 2};\nselection_sort(a, 3);\nCHECK_EQ(a[0], 1);\nCHECK_EQ(a[1], 2);\nCHECK_EQ(a[2], 2);",
      "hint": "Duplicates fine."
    },
    {
      "name": "single",
      "code": "int a[] = {5};\nselection_sort(a, 1);\nCHECK_EQ(a[0], 5);",
      "hint": "n=1 no-op."
    }
  ],
  "level": "guided"
}
