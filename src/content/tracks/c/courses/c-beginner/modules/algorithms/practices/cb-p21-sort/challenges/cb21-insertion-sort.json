{
  "id": "cb21-insertion-sort",
  "title": "Insertion Sort",
  "prompt": "Implement `void insertion_sort(int *a, int n)` sorting ascending in place.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "basic",
      "code": "int a[] = {4, 2, 9, 1};\ninsertion_sort(a, 4);\nCHECK_EQ(a[0], 1);\nCHECK_EQ(a[3], 9);",
      "hint": "Grow the sorted prefix."
    },
    {
      "name": "negatives",
      "code": "int a[] = {-1, -9, 4};\ninsertion_sort(a, 3);\nCHECK_EQ(a[0], -9);\nCHECK_EQ(a[2], 4);",
      "hint": "Works below zero."
    },
    {
      "name": "two",
      "code": "int a[] = {9, 3};\ninsertion_sort(a, 2);\nCHECK_EQ(a[0], 3);\nCHECK_EQ(a[1], 9);",
      "hint": "Smallest case that moves."
    }
  ],
  "level": "guided"
}
