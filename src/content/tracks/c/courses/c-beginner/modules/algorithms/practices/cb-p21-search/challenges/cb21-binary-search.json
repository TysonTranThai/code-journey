{
  "id": "cb21-binary-search",
  "title": "Binary Search",
  "prompt": "Implement `int binary_search_cj(const int *a, int n, int t)` on an ASCENDING-sorted array: return any index of t, or -1. Use the halving loop.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "first",
      "code": "int a[] = {2, 4, 6, 8, 10};\nCHECK_EQ(binary_search_cj(a, 5, 2), 0);",
      "hint": "Lo boundary."
    },
    {
      "name": "last",
      "code": "int a[] = {2, 4, 6, 8, 10};\nCHECK_EQ(binary_search_cj(a, 5, 10), 4);",
      "hint": "Hi boundary."
    },
    {
      "name": "middle",
      "code": "int a[] = {2, 4, 6, 8, 10};\nCHECK_EQ(binary_search_cj(a, 5, 6), 2);",
      "hint": "First split hits it."
    },
    {
      "name": "absent below",
      "code": "int a[] = {2, 4, 6};\nCHECK_EQ(binary_search_cj(a, 3, 1), -1);",
      "hint": "Below the range."
    },
    {
      "name": "absent above",
      "code": "int a[] = {2, 4, 6};\nCHECK_EQ(binary_search_cj(a, 3, 9), -1);",
      "hint": "Above the range."
    },
    {
      "name": "absent middle",
      "code": "int a[] = {2, 4, 8};\nCHECK_EQ(binary_search_cj(a, 3, 5), -1);",
      "hint": "Inside a gap."
    },
    {
      "name": "single found",
      "code": "int a[] = {7};\nCHECK_EQ(binary_search_cj(a, 1, 7), 0);",
      "hint": "One element."
    },
    {
      "name": "single absent",
      "code": "int a[] = {7};\nCHECK_EQ(binary_search_cj(a, 1, 3), -1);",
      "hint": "One element, miss."
    }
  ],
  "level": "independent"
}
