{
  "id": "cb21-find-first-ge",
  "title": "First >= Threshold",
  "prompt": "On an ascending array, implement `int first_ge(const int *a, int n, int t)` returning the index of the FIRST element >= t, or -1 if none. (Binary search variant — linear is acceptable but halving is the habit to build.)",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n#include <stdbool.h>\n#include <string.h>\n#include <stdlib.h>\n",
  "tests": [
    {
      "name": "inside",
      "code": "int a[] = {1, 3, 5, 7};\nCHECK_EQ(first_ge(a, 4, 4), 2);",
      "hint": "5 is the first >= 4."
    },
    {
      "name": "at boundary",
      "code": "int a[] = {1, 3, 5, 7};\nCHECK_EQ(first_ge(a, 4, 3), 1);",
      "hint": "Equal counts."
    },
    {
      "name": "all below",
      "code": "int a[] = {1, 2};\nCHECK_EQ(first_ge(a, 2, 9), -1);",
      "hint": "None qualify."
    },
    {
      "name": "all above",
      "code": "int a[] = {5, 6};\nCHECK_EQ(first_ge(a, 2, 0), 0);",
      "hint": "Index 0 qualifies."
    }
  ],
  "level": "independent"
}
