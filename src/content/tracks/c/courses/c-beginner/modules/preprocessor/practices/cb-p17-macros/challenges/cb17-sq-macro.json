{
  "id": "cb17-sq-macro",
  "title": "PARENTHESIZED SQUARE",
  "prompt": "Define `#define SQ(x)` so that SQ of ANY integer expression computes its square. The tests compile SQ against compound arguments.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n",
  "tests": [
    {
      "name": "plain",
      "code": "CHECK_EQ(SQ(4), 16);",
      "hint": "4*4."
    },
    {
      "name": "compound arg",
      "code": "CHECK_EQ(SQ(2 + 3), 25);",
      "hint": "Without inner parens this is 2+3*2+3 = 11."
    },
    {
      "name": "in expression",
      "code": "CHECK_EQ(SQ(3) + 1, 10);",
      "hint": "Outer parens keep +1 outside."
    }
  ],
  "level": "imitation"
}
