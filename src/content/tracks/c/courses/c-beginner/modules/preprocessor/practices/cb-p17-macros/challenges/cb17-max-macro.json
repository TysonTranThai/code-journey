{
  "id": "cb17-max-macro",
  "title": "Ternary MAX",
  "prompt": "Define `#define MAX(a, b)` yielding the larger value. It must work inside larger expressions.",
  "difficulty": "beginner",
  "language": "c",
  "boilerplate": "#include <stdio.h>\n",
  "tests": [
    {
      "name": "basic",
      "code": "CHECK_EQ(MAX(3, 7), 7);",
      "hint": "Bigger wins."
    },
    {
      "name": "negative",
      "code": "CHECK_EQ(MAX(-9, -2), -2);",
      "hint": "Negatives compare fine."
    },
    {
      "name": "expression args",
      "code": "int i = 5;\nCHECK_EQ(MAX(i * 2, 9), 10);",
      "hint": "Each arg used exactly once here — safe."
    },
    {
      "name": "nested",
      "code": "CHECK_EQ(MAX(MAX(1, 5), 3), 5);",
      "hint": "Macros nest."
    }
  ],
  "level": "guided"
}
