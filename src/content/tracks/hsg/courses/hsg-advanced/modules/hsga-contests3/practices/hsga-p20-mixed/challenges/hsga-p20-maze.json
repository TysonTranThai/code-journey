{
  "id": "hsga-p20-maze",
  "title": "Keyed Maze",
  "prompt": "**Problem.** A grid maze: '.', '#', 'S' (start), 'E' (exit), 'K'\n(key), 'D' (locked door — passable only after picking up the key).\nPrint the minimum number of steps from S to E, or -1.\n\n**Constraints:** 1 <= R, C <= 500.\n\n**R versus W.** The graded wrong solution runs BFS without the key\nstate.\n",
  "difficulty": "advanced",
  "language": "cpp",
  "boilerplate": "#include <bits/stdc++.h>\nusing namespace std;\n\nvoid solve(istream& in, ostream& out) {\n    // Đọc dữ liệu từ `in` (dùng như cin), in kết quả ra `out` (dùng như cout).\n    // (Ghép bài thực tế: chương trình thi đọc từ bàn phím / tệp — ở đây\n    //  để chấm tự động, dữ liệu vào/ra đi qua hai luồng này.)\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    solve(cin, cout);\n    return 0;\n}\n",
  "tests": [
    {
      "name": "keyed maze",
      "code": "std::istringstream in(\"3 3\\nS..\\n.##\\nKDE\\n\");\nstd::ostringstream out;\nstd::streambuf* cout_old = std::cout.rdbuf(out.rdbuf());\nsolve(in, out);\nstd::cout.rdbuf(cout_old);\nCHECK_EQ(out.str(), std::string(\"4\\n\"));",
      "hint": "Down for the key, then through the door: 4 steps. Stateless W leaves E unreachable (-1)."
    },
    {
      "name": "no door",
      "code": "std::istringstream in(\"1 3\\nS.E\\n\");\nstd::ostringstream out;\nstd::streambuf* cout_old = std::cout.rdbuf(out.rdbuf());\nsolve(in, out);\nstd::cout.rdbuf(cout_old);\nCHECK_EQ(out.str(), std::string(\"2\\n\"));",
      "hint": "Without a door both searches agree."
    },
