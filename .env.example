[TEMPLATE]
# Copy this file to .env.local and fill in values as features are implemented.
# NEVER commit .env, .env.local, or any real secrets.
# Only variables required by the currently installed architecture are listed.

# ── Database (PostgreSQL via Docker Compose) ──
# Port 5433 is used on purpose: 5432 is commonly taken by a local Postgres.
DATABASE_URL="postgresql://codejourney:codejourney@localhost:5433/codejourney"

# ── Authentication (Auth.js) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth. Create at https://github.com/settings/developers
# Unset → GitHub login is disabled (email/password still works).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI mentor (provider-agnostic seam) ──
# The platform is fully functional with these empty: the mentor degrades to
# content-derived hints (NullMentor). A real provider activates when these
# are set AND its adapter is wired (docs/PRODUCTION.md).
AI_API_KEY=
AI_BASE_URL=
MENTOR_API_KEY=

# ── Email transport ──
# Dev: unset → the reset link is logged to the console.
# Production: EMAIL_PROVIDER=smtp + SMTP_URL + EMAIL_FROM enable real email
# (password reset). Example SMTP_URL: smtps://user:pass@smtp.example.com:465
EMAIL_FROM=
SMTP_URL=
EMAIL_PROVIDER=

# ── Private beta access (Phase 9) ──
# When set (hex sha-256 of the invite phrase), registration requires that code.
# Generate: printf '%s' 'your-invite-phrase' | shasum -a 256 | cut -d' ' -f1
BETA_INVITE_CODE_SHA256=

# ── Canonical site URL (SEO, sitemap, robots, auth callbacks) ──
# Production: set to the real https origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Inactive-account cleanup (7-day policy) ──
# An account whose last qualifying activity (registration, sign-in, or any
# authenticated request) is strictly older than INACTIVE_ACCOUNT_DAYS days is
# deleted by the scheduled cleanup job. Admin accounts and accounts with no
# known activity are NEVER deleted. Default: 7.
#   pnpm cleanup:dry-run   report only (compose `cleanup` profile default)
#   pnpm cleanup           delete (explicit; see deploy/prod.yml comments)
INACTIVE_ACCOUNT_DAYS=7

# ── Sandbox execution (07-10) ──
# Local dev/tests: leave unset → the machine's own Docker daemon.
# Private beta: the WORKER process points at the DEDICATED sandbox worker host
# so the web tier never holds a Docker socket (host-level privilege). The
# endpoint must be network-restricted to the worker and never public.
# e.g. SANDBOX_DOCKER_HOST=ssh://sandbox-host (docker -H syntax)
SANDBOX_DOCKER_HOST=
# Sandbox image (default codejourney-sandbox:latest).
SANDBOX_IMAGE=
# Worker polling interval in ms (default 1000).
POLL_INTERVAL_MS=
