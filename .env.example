[TEMPLATE]
# Copy this file to .env.local and fill in values as features are implemented.
# NEVER commit .env, .env.local, or any real secrets.
# Only variables required by the currently installed architecture are listed.
# Phase 1 (this phase) requires NONE of them at runtime — they are declared
# here because the architecture (docs/ARCHITECTURE.md) depends on them in
# upcoming phases.

# ── Database (PostgreSQL via Docker Compose; wired up in Phase 2) ──
# Port 5433 is used on purpose: 5432 is commonly taken by a local Postgres.
DATABASE_URL="postgresql://codejourney:codejourney@localhost:5433/codejourney"

# ── Authentication (Auth.js; wired up in Phase 2) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth (Phase 2). Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI provider (Phase 5; intentionally provider-agnostic — see docs/ARCHITECTURE.md) ──
# The platform is fully functional with this empty.
AI_API_KEY=
AI_BASE_URL=

# ── Email transport (Phase 2; dev transport logs to console when unset) ──
EMAIL_FROM=
SMTP_URL=

# ── Sandbox execution (07-10) ──
# Local dev/tests: leave unset → the machine's own Docker daemon.
# Private beta: point at the DEDICATED sandbox worker host so the web tier
# never holds a Docker socket (host-level privilege). The endpoint must be
# network-restricted to the worker and never public.
SANDBOX_DOCKER_HOST=
# Sandbox image (default codejourney-sandbox:latest).
SANDBOX_IMAGE=
